<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- tests/Contract runs against a local Puntjes app only. Set PUNTJES_BASE_URL, PUNTJES_CLIENT_ID and
             PUNTJES_CLIENT_SECRET. When they are unset the suite fails: a refusal is a failure, never a skip. -->
        <env name="PUNTJES_BASE_URL" value=""/>
    </php>
</phpunit>

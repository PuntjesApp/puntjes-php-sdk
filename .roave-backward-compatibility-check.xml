<?xml version="1.0" encoding="UTF-8"?>
<roave-bc-check xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Roave/BackwardCompatibilityCheck/8.23.x/Resources/schema.xsd">
    <!-- A request body that becomes optional (scripts/optional-bodies.php) breaks only a subclass of a generated
         builder, never a caller. Only the exact widening from T to T|null is ignored. -->
    <baseline>
        <ignored-regex>#^\[BC\] CHANGED: The parameter \$body of Puntjes\\Generated\\[\w\\]+RequestBuilder\#(post|put|patch|to(Post|Put|Patch)RequestInformation)\(\) changed from ([\w\\]+) to \3\|null$#</ignored-regex>
    </baseline>
</roave-bc-check>
